NODE_ENV=production
PORT=8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://user:password@host:5432/melodica
DATABASE_SSL=true
CORS_ORIGIN=https://your-app-domain.example
ALLOW_LOCAL_DEMO=false
PROVIDER_GATEWAY_URL=
PROVIDER_GATEWAY_API_KEY=
PUBLIC_BASE_URL=https://api.your-domain.example
ASSETS_DIR=./assets
NEW_USER_CREDITS=500
GOOGLE_PLAY_VERIFIER_URL=https://billing-verifier.your-domain.example/verify
GOOGLE_PLAY_VERIFIER_API_KEY=
